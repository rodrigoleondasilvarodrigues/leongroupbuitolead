# Copie para .env e preencha. Sem estas chaves o CRM roda em MODO SIMULADO
# (registra tudo no banco e no console, mas não envia nada de verdade).

# Z-API — ponte entre o CRM e o WhatsApp (~R$100/mês)
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# OpenAI — varia cada mensagem para nunca sair duas idênticas
OPENAI_API_KEY=

# Porta do servidor (padrão 8770)
PORTA=8770
